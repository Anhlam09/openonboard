# Copy this file to .env and fill in what you have. Never commit .env.

# Middesk. Leave blank to run in MOCK mode (no account needed).
# Sandbox keys start with mk_test_ ; live keys start with mk_live_
MIDDESK_API_KEY=
MIDDESK_BASE_URL=https://api-sandbox.middesk.com/v1
# Auth style: bearer (current Middesk API reference) or basic
MIDDESK_AUTH=bearer
# KYB package to order with each business. Blank = your account's default.
MIDDESK_ORDER_PRODUCT=business_verification_verify
# Secret you set when you register a webhook with Middesk (needed for /webhooks/middesk)
MIDDESK_WEBHOOK_SECRET=

# One shared password for the reviewer side (queue, decisions, maintenance, exports). Any username works.
# Blank in mock mode = reviewer pages are open for demos. Required once MIDDESK_API_KEY is set.
REVIEWER_PASSWORD=

# Database file (SQLite)
DATABASE_PATH=openonboard.db

# Where uploaded documents are stored (a folder on local disk)
DOCUMENTS_DIR=uploads
